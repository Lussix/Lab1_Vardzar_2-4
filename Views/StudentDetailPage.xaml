<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lab1_Vardzar_2_4.Views.StudentDetailPage"
             Title="Деталі студента">

    <VerticalStackLayout Padding="30" Spacing="15">

        <Label Text="{Binding FullName}"
               FontSize="24"
               FontAttributes="Bold" />

        <Label Text="{Binding Group, StringFormat='Група: {0}'}"
               FontSize="18" />

        <Label Text="{Binding AverageScore, StringFormat='Середній бал: {0}'}"
               FontSize="18" />

    </VerticalStackLayout>
</ContentPage>