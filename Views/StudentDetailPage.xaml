<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lab1_Vardzar_2_4.Views.StudentDetailPage"
             Title="Деталі студента">

    <VerticalStackLayout Padding="30" Spacing="15">

        <Label Text="{Binding FullName}"
               FontSize="24"
               FontAttributes="Bold" />

        <Label Text="{Binding Group, StringFormat='Група: {0}'}"
               FontSize="18" />

        <Label Text="Середній бал:" FontSize="18" />

        <Entry Text="{Binding AverageScore, Mode=TwoWay}"
               Keyboard="Numeric"
               Placeholder="Середній бал" />

        <Button Text="Зберегти"
                Command="{Binding SaveCommand}" />

        <Button Text="Назад"
                Command="{Binding GoBackCommand}" />

    </VerticalStackLayout>
</ContentPage>
    