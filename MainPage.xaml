<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lab1_Vardzar_2_4.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="15">

            <Label Text="Особистий кабінет студента"
                   FontSize="22"
                   HorizontalOptions="Center" />

            <Entry x:Name="FullNameEntry"
                   Text="{Binding FullName, Mode=TwoWay}"
                   Placeholder="ПІБ студента" />

            <Entry x:Name="GroupEntry"
                   Text="{Binding Group, Mode=TwoWay}"
                   Placeholder="Група" />

            <Entry x:Name="AverageScoreEntry"
                   Text="{Binding AverageScore, Mode=TwoWay}"
                   Placeholder="Середній бал"
                   Keyboard="Numeric" />

            <Label Text="{Binding FullName, Mode=OneWay, StringFormat='Студент: {0}'}"
                   FontSize="18"
                   TextColor="Blue" />

            <Label x:Name="GreetingLabel"
                   Text="{Binding Group, StringFormat='Група: {0}'}"
                   FontSize="16" />

            <Button Text="Додати студента"
                    Command="{Binding AddStudentCommand}" />

            <Label Text="Список студентів:"
                   FontSize="18"
                   Margin="0,15,0,0" />

            <CollectionView ItemsSource="{Binding Students}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Padding="0,5">
                            <Label Text="{Binding FullName}" FontAttributes="Bold" />
                            <Label Text="{Binding Group, StringFormat='Група: {0}'}" FontSize="13" />
                            <Label Text="{Binding AverageScore, StringFormat='Середній бал: {0}'}" FontSize="13" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage> 